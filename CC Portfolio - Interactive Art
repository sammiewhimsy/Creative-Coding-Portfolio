function setup() {
  createCanvas(window.innerWidth, window.innerHeight);
  angleMode(DEGREES);
}

let angle = 0;
let radius = 0;
function draw() {
  let radiusInc = random(0.01,0.5);
  for (let i = 0; i < 4000; i++); {
    translate(width/2, height/2);
    rotate(angle);
    angle+=25;
    radius+=radiusInc;
    stroke(random(255), random(255), random(255));
    strokeWeight(6);
    point(radius, 0);
  }
}
