function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(0);
  noStroke();
  var circleSize = 80;
  translate(circleSize/2,circleSize/2);
  for(var x = 0; x < width; x += circleSize) {
    for(var y = 0; y < height; y += circleSize) {
      fill(255);
        circle(x,y,circleSize*1.2,circleSize*1.2);
      fill(0);
        ellipse(x,y,circleSize*0.8,circleSize*0.5);
      fill(255);
        ellipse(x,y,circleSize*0.2,circleSize*0.4)
    }
  }
}
