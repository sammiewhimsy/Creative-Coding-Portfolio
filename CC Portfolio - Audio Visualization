var mySound, fft;
function preload() {
  mySound = loadSound('Hotline Sans.mp3');
}

function setup() {
  createCanvas(600, 400);
  background(0);
  fft = new p5.FFT();
  mySound.setVolume(1);
  mySound.play();
}
function draw() {
  background('black');
  var spectrum = fft.analyze();
  noStroke();
  fill('rgb(93,47,198)');
  for(var i=0;i<spectrum.length; i++){
    var x=map(i,0,spectrum.length,0,width);
    var h=map(spectrum[i],0,255,0,height);
    rect(x,height-h,width/spectrum.length,h)
  }
  
  textSize(30);
  text('hotline sans',320,80);
  fill('white');
  push();
  translate(230,15);
  scale(2);
  ellipse(80,100,100,70);
  ellipse(80,80,100,70);
  fill('black');
  ellipse(57,85,35,30);
  ellipse(103,85,35,30);
  fill('white');
  ellipse(107,79,10,10);
  ellipse(61,79,10,10);
  pop();
  push();
  fill('black');
  translate(390,225);
  scale(0.9);
  rotate(128.8);
  beginShape();
  vertex(0, 0);
  bezierVertex(0, -20, 40, -10, 0, 25);
  vertex(0, 0);
  bezierVertex(0, -20, -40, -10, 0, 25);
  endShape();
}
